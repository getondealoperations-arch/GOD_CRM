# Copy to .env.local (dev) or .env.production
DATABASE_URL=mysql://root:password@localhost:3306/getondeal_crm
# Long random string (32+ chars). Signs sessions and encrypts stored Meta/WhatsApp/Exotel/SMTP secrets —
# changing it logs everyone out and requires re-entering those secrets.
APP_SECRET=change-me-to-a-long-random-string
# Initial super admin password used by `npm run db:setup` (only when no users exist)
ADMIN_PASSWORD=Admin@123
# Public URL — used in notification links, OAuth redirect and telephony callbacks (can also be set in Settings)
# APP_URL=https://crm.getondeal.com

# Optional
# META_GRAPH_VERSION=v23.0
# DB_POOL_SIZE=20           # MySQL connections per app instance
# STORAGE_DIR=./storage     # uploads + background export files (shared storage if several instances)
# BACKUP_DIR=./backups      # where backups are written; sync it off-site
# MYSQLDUMP=mysqldump       # or mariadb-dump
# AUTOMATION=off            # disable the in-process automation loop (multi-instance deploys)
# CRON_SECRET=...           # then call POST /api/cron with "Authorization: Bearer $CRON_SECRET" every minute
